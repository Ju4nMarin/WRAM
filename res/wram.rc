#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_SPANISH, SUBLANG_NEUTRAL

IDI_APP ICON "wram.ico"
IDR_SETTINGS_HTML RCDATA "settings.min.html"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "wram.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,0
 PRODUCTVERSION 1,4,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName", "Juan Guillermo Marín Córdoba"
            VALUE "FileDescription", "WRAM - monitor del sistema en la barra de tareas"
            VALUE "FileVersion", "1.4.0"
            VALUE "InternalName", "WRAM"
            VALUE "LegalCopyright", "© 2026 Juan Guillermo Marín Córdoba. Licencia MIT."
            VALUE "OriginalFilename", "WRAM.exe"
            VALUE "ProductName", "WRAM"
            VALUE "ProductVersion", "1.4.0"
            VALUE "Comments", "Desarrollado por Juan Guillermo Marín Córdoba. https://github.com/Ju4nMarin/WRAM"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
