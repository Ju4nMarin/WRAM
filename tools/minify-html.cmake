# Prepara settings.html para incrustarlo en el ejecutable:
# reemplaza los marcadores de logo por los PNG en base64 de assets/ y quita sangría,
# líneas vacías y comentarios de línea completa (// y /* */). No reescribe CSS ni JS.
file(READ "${IN}" html)
file(READ "${ASSETS}/logo-horizontal-light.b64" logo_h)
file(READ "${ASSETS}/logo-mark.b64" logo_m)
string(STRIP "${logo_h}" logo_h)
string(STRIP "${logo_m}" logo_m)
string(REPLACE "__LOGO_HORIZONTAL__" "data:image/png;base64,${logo_h}" html "${html}")
string(REPLACE "__LOGO_MARK__" "data:image/png;base64,${logo_m}" html "${html}")
string(REPLACE "\r" "" html "${html}")
string(REGEX REPLACE "\n[ \t]+" "\n" html "${html}")
string(REGEX REPLACE "\n//[^\n]*" "" html "${html}")
string(REGEX REPLACE "\n/\\*[^\n]*\\*/" "" html "${html}")
string(REGEX REPLACE "\n\n+" "\n" html "${html}")
file(WRITE "${OUT}" "${html}")

# Política de seguridad sin 'unsafe-inline': el único <style> y el único <script> del archivo final se
# autorizan por su hash SHA-256, calculado aquí sobre el texto exacto que carga la ventana.
function(hex_to_base64 hex out)
  set(abc "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  string(LENGTH "${hex}" n)
  set(result "")
  set(i 0)
  while(i LESS n)
    math(EXPR left "${n} - ${i}")
    if(left GREATER_EQUAL 6)
      string(SUBSTRING "${hex}" ${i} 6 chunk)
      set(chars 4)
    else()
      string(SUBSTRING "${hex}" ${i} ${left} chunk)
      math(EXPR chars "${left} / 2 + 1")
      while(left LESS 6)
        string(APPEND chunk "00")
        math(EXPR left "${left} + 2")
      endwhile()
    endif()
    math(EXPR v "0x${chunk}")
    foreach(shift 18 12 6 0)
      if(chars GREATER 0)
        math(EXPR idx "(${v} >> ${shift}) & 63")
        string(SUBSTRING "${abc}" ${idx} 1 ch)
        string(APPEND result "${ch}")
        math(EXPR chars "${chars} - 1")
      else()
        string(APPEND result "=")
      endif()
    endforeach()
    math(EXPR i "${i} + 6")
  endwhile()
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(inline_hash html open close out)
  string(FIND "${html}" "${open}" start)
  string(FIND "${html}" "${close}" stop REVERSE)
  if(start LESS 0 OR stop LESS start)
    message(FATAL_ERROR "settings.html: no se encontró ${open}")
  endif()
  string(LENGTH "${open}" len)
  math(EXPR start "${start} + ${len}")
  math(EXPR len "${stop} - ${start}")
  string(SUBSTRING "${html}" ${start} ${len} body)
  string(SHA256 hex "${body}")
  hex_to_base64(${hex} b64)
  set(${out} "'sha256-${b64}'" PARENT_SCOPE)
endfunction()

file(READ "${OUT}" final)
inline_hash("${final}" "<style>" "</style>" style_hash)
inline_hash("${final}" "<script>" "</script>" script_hash)
string(REPLACE "__CSP_STYLE__" "${style_hash}" final "${final}")
string(REPLACE "__CSP_SCRIPT__" "${script_hash}" final "${final}")
file(WRITE "${OUT}" "${final}")
